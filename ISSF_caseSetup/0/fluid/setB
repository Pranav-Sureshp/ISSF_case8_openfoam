FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       IOobject;
    location    "0/fluid";
    object      setB;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //




magneticField #codeStream
{

  code #{
    const scalar Bzero = 0.50;
    const scalar sigma_x = 0.1;
    const scalar x_c = 0.7315;

    const IOdictionary& d = static_cast<const IOdictionary&>(dict);
    const fvMesh& mesh = refCast<const fvMesh>(d.db());

    vectorField fld(mesh.nCells(), vector::zero);

    forAll(mesh.C(), i)
    {
        const scalar x = mesh.C()[i].x();

        // Force double precision and a smoother transition
        scalar arg = (mag(x) - x_c) / sigma_x;

        // Optional: clamp the argument to avoid any numerical issues at extremes
        // arg = max(min(arg, 20.0), -20.0);   // rarely needed

        scalar upper = (Bzero / 2.0) * (1.0 - Foam::tanh(arg));

        fld[i] = vector(0.0, upper, 0.0);   // removed unnecessary "lower = 1.0"
    }

    fld.writeEntry("", os);
  #};
  
  codeInclude
  #{
  #include "fvCFD.H"
  #};
  
  codeOptions
  #{
      -I$(LIB_SRC)/finiteVolume/lnInclude \
      -I$(LIB_SRC)/meshTools/lnInclude
  #};
  codeLibs
  #{
      -lfiniteVolume \
      -lmeshTools
  #};
};
#inputMode merge;
